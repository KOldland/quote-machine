{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {},
  "command": {
    "boot": {
      "template": "Please read the attached context files (context.md, system_architecture.md, calculator.md, SESSION.md) and initialize this session according to the instructions in boot.md. Report back only as requested in that file.",
      "description": "Initialize fresh session with static blueprints and 5-request budget"
    },
    "wrap": {
      "template": "Summarize current progress, prepare handoff updates for SESSION.md and current_development.md, and provide the Git commands for a clean repository save. Follow the instructions in wrap.md.",
      "description": "Summarize progress, update tracking files, and generate Git commit commands"
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "REMOVED_SECRET",
        "timeout": 300000
      },
      "models": {
        "qwen/qwen3.6-flash": {
          "name": "OR: Qwen 3.6 Flash ($0.1875/$1.13)",
          "limit": {
            "context": 1000000,
            "output": 4096
          },
          "cost": {
            "input": 0.1875,
            "output": 1.13
          }
        },
        "google/gemini-3.5-flash": {
          "name": "OR: Gemini 3.5 Flash ($1.50/$9.00)",
          "limit": {
            "context": 1048576,
            "output": 4096
          },
          "cost": {
            "input": 1.5,
            "output": 9
          },
          "modalities": {
            "input": ["text", "image"]
          },
          "tool_call": true
        },
        "google/gemini-3.1-flash-lite": {
          "name": "OR: Gemini 3.1 Flash-Lite ($0.25 / $1.50)",
